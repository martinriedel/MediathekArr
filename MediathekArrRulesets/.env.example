# Copy to .env and fill in. Everything except RULESETS_API_KEY is optional.

# Image tag: dev (newest test build) or latest (main)
RULESETS_TAG=dev
RULESETS_PORT=5008
TZ=Europe/Berlin

# Key for all writes (generator, import, editing). Pick a long random string.
RULESETS_API_KEY=

# TVDB v4 key (and PIN if your key needs one)
TVDB_API_KEY=
TVDB_PIN=

# Your local LLM, any OpenAI-compatible endpoint (Ollama: http://<host>:11434/v1)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Pause in seconds after every LLM request, so long scans don't keep the GPU at full load
LLM_PAUSE_SECONDS=0

# Discovery: scan MediathekView for new series on its own (needs TVDB_API_KEY), every N hours (0 = off)
DISCOVER_INTERVAL_HOURS=24

# Sonarr (optional): also generate rulesets for your whole library
SONARR_URL=
SONARR_API_KEY=
# Run the generator automatically every N hours (0 = only when started by hand)
GENERATE_INTERVAL_HOURS=0

# Sources for the initial/upstream import (comma separated)
#UPSTREAM_RULESETS_URLS=https://mediathekarr.pcjones.de/metadata/api/rulesets.php,https://raw.githubusercontent.com/rundfunkarr/rundfunkarr/main/data/rulesets.json

# Share of a topic's entries a ruleset must match to be accepted
MIN_MATCH_RATE=0.8
