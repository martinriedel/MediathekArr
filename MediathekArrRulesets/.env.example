# Copy to .env and fill in. Everything except RULESETS_API_KEY is optional.

# Image tag: dev (newest test build) or latest (main)
RULESETS_TAG=dev
RULESETS_PORT=5008
TZ=Europe/Berlin

# Key for all writes (generator, import, editing). Pick a long random string.
RULESETS_API_KEY=

# TVDB v4 key (and PIN if your key needs one)
TVDB_API_KEY=
TVDB_PIN=

# Your local LLM, any OpenAI-compatible endpoint (Ollama: http://<host>:11434/v1)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Sonarr: generate rulesets for your whole library
SONARR_URL=
SONARR_API_KEY=
# Run the generator automatically every N hours (0 = only when started by hand)
GENERATE_INTERVAL_HOURS=0

# Share of a topic's entries a ruleset must match to be accepted
MIN_MATCH_RATE=0.8
